# The settings the server functions need. Add these names and values in
# Vercel → your project → Settings → Environment Variables (tick all environments).
TMDB_API_KEY=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
MY_EMAIL=
# Optional but recommended: Sarah's email. When set, her copy only ever goes to this address.
HER_EMAIL=
